<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure routing core. MUST NOT reference any game or Unity assembly (plan §5:
       ports-and-adapters). netstandard2.1 target keeps it loadable by the game's
       Mono/IL2CPP runtime; net8.0 target is used by the out-of-game harness. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>CA1861</NoWarn>
  </PropertyGroup>

</Project>
